# ============================================================================
# STZ AutoPartes · configuración Apache para Hostinger
# ============================================================================

# Charset por defecto
AddDefaultCharset UTF-8

RewriteEngine On

# --- HTTPS forzado (Hostinger emite el certificado gratis desde el panel) ----
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --- Vista previa de producto en WhatsApp ------------------------------------
# producto.html arma la ficha desde el navegador y los crawlers no ejecutan JS,
# así que el link salía sin miniatura. producto.php devuelve el MISMO HTML con
# las etiquetas og:* del producto inyectadas en el <head>.
# Es un rewrite interno: la URL que ve el usuario no cambia.
#
# Solo se desvía a los BOTS de vista previa. Las personas siguen recibiendo el
# producto.html estático de siempre: si el hosting no tuviera PHP, lo peor que
# pasa es que se pierde la miniatura, nunca que se rompa la página.
# OJO con el destino: tiene que ir SIN barra inicial. Con "/producto.php"
# LiteSpeed (el servidor de Hostinger) lo toma como ruta de archivo y devuelve
# el PHP como texto plano, sin ejecutarlo. En relativo vuelve a pasar por el
# handler de PHP, que es lo que queremos.
RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|WhatsApp|Twitterbot|TelegramBot|Discordbot|Slackbot|LinkedInBot|SkypeUriPreview|Applebot|Googlebot|bingbot|redditbot|Pinterest|vkShare|W3C_Validator) [NC]
RewriteRule ^producto\.html$ producto.php [L,QSA]

# --- URLs limpias: /catalogo → /catalogo.html --------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^\.]+)$ $1.html [NC,L]

# --- Trailing slash consistente: /catalogo/ → /catalogo ---------------------
RewriteCond %{REQUEST_URI} /$
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# --- Home explícito ----------------------------------------------------------
DirectoryIndex index.html

# ============================================================================
# Cache de assets estáticos
# ============================================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"

  # Imágenes: cache largo, casi no cambian
  ExpiresByType image/jpeg  "access plus 30 days"
  ExpiresByType image/png   "access plus 30 days"
  ExpiresByType image/webp  "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"

  # Fuentes (por si en el futuro se hostean localmente)
  ExpiresByType font/woff2  "access plus 30 days"
  ExpiresByType font/woff   "access plus 30 days"

  # CSS y JS: cache muy corto durante fase de iteracion.
  # Cuando el sitio se estabilice, subir a 7 dias.
  ExpiresByType text/css                "access plus 0 seconds"
  ExpiresByType application/javascript  "access plus 0 seconds"
  ExpiresByType text/javascript         "access plus 0 seconds"

  # HTML: no cachear (siempre servir la última versión)
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ============================================================================
# Compresión gzip / deflate
# ============================================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ============================================================================
# Seguridad básica
# ============================================================================
<IfModule mod_headers.c>
  # Bloquear iframes cross-site
  Header always set X-Frame-Options "SAMEORIGIN"
  # Evitar sniffing de MIME
  Header always set X-Content-Type-Options "nosniff"
  # Referrer razonable
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # ---------------------------------------------------------------------------
  # Cache de JS/CSS: se fuerza acá además de mod_expires porque el hosting venía
  # respondiendo max-age=604800 (7 días) y los cambios no llegaban al visitante
  # que ya tenía el archivo cacheado. Con must-revalidate el navegador siempre
  # pregunta y el 304 sigue siendo barato.
  # Igual el HTML versiona los assets con ?v=, que es lo que realmente garantiza
  # que un cambio se vea sin depender de estos headers.
  # ---------------------------------------------------------------------------
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Ocultar el .htaccess a curiosos
<Files ".htaccess">
  Require all denied
</Files>

# ============================================================================
# 404: si un día se crea un 404.html descomentar la línea
# ============================================================================
# ErrorDocument 404 /404.html
